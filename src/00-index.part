path: index.html
title: The AI/ML Engineering Handbook
ogtitle: The AI/ML Engineering Handbook
desc: A staged roadmap, a RAG deep dive, 122 interview questions and a startup playbook — for people who ship machine learning systems, not notebooks. Free, no signup.
og: og-default.png
scripts: progress, router
---
<main id="main">
<div class="shell">

<section class="win" style="margin-top:var(--sp-6)">
  <div class="win__bar">
    <span class="win__dots">[_][□][X]</span>
    <span class="win__title">ka1manov@handbook: ~/ai-ml-handbook</span>
  </div>
  <div class="win__body">
    <p class="prompt">python -m handbook --serve --free</p>
    <div class="log" aria-label="Contents">
      <div class="log__row"><span class="log__t">[00:00:00]</span><span class="log__lvl">init</span><span class="log__msg">loading curriculum … 7 stages, 42 nodes</span></div>
      <div class="log__row"><span class="log__t">[00:00:00]</span><span class="log__lvl log__lvl--ok">ok</span><span class="log__msg"><a href="#stage-00">stage 00 · foundations</a> — the maths and engineering you actually use</span></div>
      <div class="log__row"><span class="log__t">[00:00:00]</span><span class="log__lvl log__lvl--ok">ok</span><span class="log__msg"><a href="#stage-01">stage 01 · classical ml</a> — the baselines you must beat</span></div>
      <div class="log__row"><span class="log__t">[00:00:00]</span><span class="log__lvl log__lvl--ok">ok</span><span class="log__msg"><a href="#stage-02">stage 02 · deep learning</a> — training loops that converge</span></div>
      <div class="log__row"><span class="log__t">[00:00:01]</span><span class="log__lvl log__lvl--ok">ok</span><span class="log__msg"><a href="#stage-03">stage 03 · transformers &amp; llms</a> — attention to alignment</span></div>
      <div class="log__row"><span class="log__t">[00:00:01]</span><span class="log__lvl log__lvl--ok">ok</span><span class="log__msg"><a href="#stage-04">stage 04 · applied llm systems</a> — rag, agents, fine-tuning</span></div>
      <div class="log__row"><span class="log__t">[00:00:01]</span><span class="log__lvl log__lvl--ok">ok</span><span class="log__msg"><a href="#stage-05">stage 05 · production &amp; llmops</a> — serving, eval, cost, observability</span></div>
      <div class="log__row"><span class="log__t">[00:00:01]</span><span class="log__lvl log__lvl--ok">ok</span><span class="log__msg"><a href="#stage-06">stage 06 · specialisation</a> — pick a depth and go</span></div>
      <div class="log__row"><span class="log__t">[00:00:01]</span><span class="log__lvl">also</span><span class="log__msg"><a href="rag.html">rag deep dive</a>, <a href="interview.html">122 interview questions</a>, <a href="startups.html">startup playbook</a>, <a href="tips.html">50 field notes</a>, <a href="articles/index.html">6 long reads</a></span></div>
      <div class="log__row"><span class="log__t">[00:00:02]</span><span class="log__lvl log__lvl--ok">ready</span><span class="log__msg">serving on this page<span class="cursor" aria-hidden="true"></span></span></div>
